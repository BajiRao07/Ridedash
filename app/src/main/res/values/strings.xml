    <string name="layout_bike">Bike – always portrait</string>
    <string name="layout_car">Car – always landscape</string>
    <string name="mode_dashboard">Bike dashboard (old phone mounted on the bike)</string>
    <string name="mode_companion">Main phone (sends calls, messages and music to the bike phone)</string>
