    <!-- Setup -->
    <string name="safety">Ride safe: set everything up before you ride. Use voice and big buttons only, keep your eyes on the road and follow local traffic laws.</string>
    <string name="h_mode">1. What is this phone?</string>
    <string name="mode_standalone">Standalone screen (recommended) – works on its own using your main phone\'s hotspot. Nothing to install on the main phone.</string>
    <string name="standalone_help">Standalone setup:\n• Turn on your main phone\'s hotspot and connect this phone to it.\n• WhatsApp on this phone → Link as companion device (WhatsApp → Linked devices on your main phone).\n• Google Messages on this phone → Device pairing, to see SMS.\n• Samsung phones: try \"Call &amp; text on other devices\" on both phones for calls.\n• Otherwise answer calls with your car or helmet Bluetooth.</string>
    <string name="h_layout">Screen layout</string>
    <string name="layout_auto">Auto – fits any screen (rotate for car mode)</string>
    <string name="layout_bike">Bike – always portrait</string>
    <string name="layout_car">Car – always landscape</string>
    <string name="mode_dashboard">Bike dashboard (old phone mounted on the bike)</string>
    <string name="mode_companion">Main phone (sends calls, messages and music to the bike phone)</string>
    <string name="h_perms">2. Permissions</string>
    <string name="btn_notif">Allow notification access</string>
    <string name="btn_perms">Allow location, phone and Bluetooth</string>
    <string name="btn_home">Set RideDash as home screen (bike phone)</string>
    <string name="btn_battery">Stop battery optimisation for RideDash</string>
    <string name="h_link">3. Secure pairing of the two phones</string>
    <string name="link_help">All data between the phones is encrypted, and only the phone you pair here is accepted.\n\n1. Pair both phones in Bluetooth settings.\n2. On the BIKE phone tap \"Start pairing\".\n3. On the MAIN phone choose the bike phone, then tap \"Pair with bike phone\".\n4. Both phones show a 6-digit code. Tap MATCH only if the codes are the same.\n\nSkip this if the old phone has its own SIM.</string>
