<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora background: deep night with soft violet and teal glows -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#070815" /></shape></item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.18" android:centerY="0.78"
                android:gradientRadius="380dp" android:startColor="#883B1E8C" android:endColor="#003B1E8C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.85" android:centerY="0.18"
                android:gradientRadius="340dp" android:startColor="#5500B3A4" android:endColor="#0000B3A4" />
        </shape>
    </item>
</layer-list>
