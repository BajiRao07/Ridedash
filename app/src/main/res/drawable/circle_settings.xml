<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#3E4656" /></shape></item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><gradient android:angle="315" android:startColor="#9AA6BC" android:endColor="#3E4656" /></shape></item>
            <item><shape android:shape="oval"><gradient android:angle="270" android:startColor="#40FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" /></shape></item>
        </layer-list>
    </item>
</selector>
