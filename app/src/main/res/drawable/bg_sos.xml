<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#B5123A" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF6B6B" android:endColor="#E11D48" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
