<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <!-- ===================== HOME (filled from home_portrait / home_landscape) ===================== -->
    <FrameLayout
        android:id="@+id/screenDash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glow" />

    <!-- ===================== ALL APPS ===================== -->
    <LinearLayout
        android:id="@+id/screenApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glow"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAppsBack"
                style="@style/Tile"
                android:background="@drawable/bg_glass"
                android:text="@string/back" />
        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:layout_marginTop="12dp"
            android:text="@string/all_apps"
            android:textColor="#FFFFFF" />

        <TextView
            style="@style/Body"
            android:text="@string/long_press_hint" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/appsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== MUSIC ===================== -->
    <LinearLayout
        android:id="@+id/screenMusic"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_glow"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMusicBack"
                style="@style/Tile"
                android:background="@drawable/bg_glass"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnOpenPlayer"
                style="@style/Tile"
                android:layout_weight="1.6"
                android:background="@drawable/bg_glass"
                android:text="@string/open_music_app"
                android:textSize="16sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/music_choose"
            android:textColor="#AEB4D0"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/musicApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="0.6" />

        <ImageView
            android:id="@+id/musicArt"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/tile_music"
            android:importantForAccessibility="no"
            android:padding="52dp"
            android:src="@drawable/ic_tile_music" />

        <TextView
            android:id="@+id/mediaTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mediaArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#AEB4D0"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/IconTile"
                android:background="@drawable/bg_glass"
                android:contentDescription="@string/prev"
                android:padding="26dp"
                android:src="@drawable/ic_prev" />

            <ImageButton
                android:id="@+id/btnPlay"
                style="@style/IconTile"
                android:background="@drawable/tile_music"
                android:contentDescription="@string/play_pause"
                android:padding="24dp"
                android:src="@drawable/ic_play_w" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/IconTile"
                android:background="@drawable/bg_glass"
                android:contentDescription="@string/next"
                android:padding="26dp"
                android:src="@drawable/ic_next" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- ===================== MAP ===================== -->
    <FrameLayout
        android:id="@+id/screenMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:text="0 km/h"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnZoomIn"
                style="@style/RoundBtn"
                android:text="+" />

            <Button
                android:id="@+id/btnZoomOut"
                style="@style/RoundBtn"
                android:text="−" />

            <Button
                android:id="@+id/btnRecenter"
                style="@style/RoundBtn"
                android:text="@string/me"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnMapBack"
                style="@style/Tile"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnNavigate"
                style="@style/Tile"
                android:layout_weight="2"
                android:background="@drawable/bg_accent"
                android:text="@string/navigate" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== MESSAGES ===================== -->
    <LinearLayout
        android:id="@+id/screenMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMsgBack"
                style="@style/Tile"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnClearMsgs"
                style="@style/Tile"
                android:text="@string/clear" />
        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:layout_marginTop="12dp"
            android:text="@string/recent_messages" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/messageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== CALLS (favourites) ===================== -->
    <LinearLayout
        android:id="@+id/screenCalls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCallsBack"
                style="@style/Tile"
                android:text="@string/back" />
        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:layout_marginTop="12dp"
            android:text="@string/favourites" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/favList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== INCOMING CALL OVERLAY ===================== -->
    <LinearLayout
        android:id="@+id/callOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/callName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReject"
                style="@style/Tile"
                android:background="@drawable/bg_reject"
                android:text="@string/reject"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnAnswer"
                style="@style/Tile"
                android:background="@drawable/bg_answer"
                android:text="@string/answer"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
