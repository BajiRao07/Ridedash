<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:keepScreenOn="true">

    <!-- ===================== DASHBOARD (auto-fits portrait = bike, landscape = car) ===================== -->
    <LinearLayout
        android:id="@+id/screenDash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <TextClock
                android:id="@+id/clock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/linkText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:ellipsize="end"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dashBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Pane A: speed -->
            <LinearLayout
                android:id="@+id/paneA"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/speedText"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="0"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="220sp"
                    app:autoSizeMinTextSize="36sp"
                    app:autoSizeTextType="uniform" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:text="@string/kmh"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Pane B: music, message, tiles -->
            <LinearLayout
                android:id="@+id/paneB"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/mediaCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/mediaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/mediaArtist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:minHeight="52dp"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnPrev"
                            style="@style/IconTile"
                            android:contentDescription="@string/prev"
                            android:src="@drawable/ic_prev" />

                        <ImageButton
                            android:id="@+id/btnPlay"
                            style="@style/IconTile"
                            android:background="@drawable/bg_accent"
                            android:contentDescription="@string/play_pause"
                            android:src="@drawable/ic_play" />

                        <ImageButton
                            android:id="@+id/btnNext"
                            style="@style/IconTile"
                            android:contentDescription="@string/next"
                            android:src="@drawable/ic_next" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/msgCard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_margin="4dp"
                    android:layout_weight="0.75"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/lastMsgFrom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/accent"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lastMsgText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="72dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnNav"
                        style="@style/AppTile"
                        android:background="@drawable/bg_accent"
                        android:drawableTop="@drawable/ic_navigate"
                        android:text="@string/go_tile"
                        android:textColor="#002E14" />

                    <Button
                        android:id="@+id/btnMap"
                        style="@style/AppTile"
                        android:drawableTop="@drawable/ic_map"
                        android:text="@string/map" />

                    <Button
                        android:id="@+id/btnMessages"
                        style="@style/AppTile"
                        android:drawableTop="@drawable/ic_chat"
                        android:text="@string/messages" />

                    <Button
                        android:id="@+id/btnCalls"
                        style="@style/AppTile"
                        android:drawableTop="@drawable/ic_call"
                        android:text="@string/calls" />

                    <Button
                        android:id="@+id/btnSetup"
                        style="@style/AppTile"
                        android:drawableTop="@drawable/ic_tune"
                        android:text="@string/setup_short" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== MAP ===================== -->
    <FrameLayout
        android:id="@+id/screenMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/mapSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:text="0 km/h"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical"
            android:padding="6dp">

            <Button
                android:id="@+id/btnZoomIn"
                style="@style/RoundBtn"
                android:text="+" />

            <Button
                android:id="@+id/btnZoomOut"
                style="@style/RoundBtn"
                android:text="−" />

            <Button
                android:id="@+id/btnRecenter"
                style="@style/RoundBtn"
                android:text="@string/me"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnMapBack"
                style="@style/Tile"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnNavigate"
                style="@style/Tile"
                android:layout_weight="2"
                android:background="@drawable/bg_accent"
                android:text="@string/navigate" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===================== MESSAGES ===================== -->
    <LinearLayout
        android:id="@+id/screenMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMsgBack"
                style="@style/Tile"
                android:text="@string/back" />

            <Button
                android:id="@+id/btnClearMsgs"
                style="@style/Tile"
                android:text="@string/clear" />
        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:layout_marginTop="12dp"
            android:text="@string/recent_messages" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/messageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== CALLS (favourites) ===================== -->
    <LinearLayout
        android:id="@+id/screenCalls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCallsBack"
                style="@style/Tile"
                android:text="@string/back" />
        </LinearLayout>

        <TextView
            style="@style/Heading"
            android:layout_marginTop="12dp"
            android:text="@string/favourites" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/favList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- ===================== INCOMING CALL OVERLAY ===================== -->
    <LinearLayout
        android:id="@+id/callOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/callStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/callName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnReject"
                style="@style/Tile"
                android:background="@drawable/bg_reject"
                android:text="@string/reject"
                android:textSize="26sp" />

            <Button
                android:id="@+id/btnAnswer"
                style="@style/Tile"
                android:background="@drawable/bg_answer"
                android:text="@string/answer"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
