<?xml version="1.0" encoding="utf-8"?>
<!-- Bike layout: big speed, 6 round icons (3 x 2), bottom bar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingTop="14dp"
    android:paddingRight="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/linkText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:ellipsize="end"
            android:maxWidth="150dp"
            android:maxLines="1"
            android:textColor="#AEB4D0"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:textColor="#AEB4D0"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btnSetup"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_glass"
            android:clickable="true"
            android:contentDescription="@string/settings"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/ic_sliders" />
    </LinearLayout>

    <TextView
        android:id="@+id/speedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="104sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.35"
        android:text="KM/H"
        android:textColor="#4FF0CF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/iconGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSos"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_sos"
            android:clickable="true"
            android:contentDescription="@string/sos_desc"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/sos"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/nowPlaying"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_music_small" />

            <TextView
                android:id="@+id/nowPlayingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#E6E8F5"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAllApps"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/circle_glass"
            android:clickable="true"
            android:contentDescription="@string/all_apps"
            android:focusable="true"
            android:padding="15dp"
            android:src="@drawable/ic_grid" />

        <ImageView
            android:id="@+id/btnPhoneHome"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/circle_glass"
            android:clickable="true"
            android:contentDescription="@string/phone_home"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_home_stroke" />
    </LinearLayout>
</LinearLayout>
